{
  "name": "prism",
  "version": "0.1.0",
  "description": "An autonomous web-recon tool: point it at an authorized target and get back a scoped, evidence-graded report. Requests can never leave a hand-written allowlist. For authorized testing only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "bin": {
    "prism": "./dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "files": [
    "dist",
    "targets",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "demo:juiceshop": "tsx demos/juiceshop.ts",
    "report:serve": "node scripts/serve-reports.mjs"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
